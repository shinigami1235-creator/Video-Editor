{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Editor",
  "version": "0.5.0",
  "identifier": "com.cygnussolutions.videoeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Video Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "maximized": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzQzU4MTE2RTUyODQ2NUEKUldSYVJpamxGb0hGNHd4S1BSNVp4bUwzUUV5SkUyZ0M0R3Y0Y0s5bUpsMytRRndNY0ptMXlEU1AK",
      "endpoints": [
        "https://github.com/shinigami1235-creator/Video-Editor/releases/download/newest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
